{
  "name": "dsh-tradewatcher",
  "version": "0.1.0",
  "description": "dsh-tradewatcher（盯盘）: a DeepSeek Harness web plugin that registers an AIDP-style market dashboard sidebar tab through ctx.betterSidebar — TopBar index/global/commodity strips with hover intraday charts, embedded 52etf cloud map, grouped watchlist, ledger-driven portfolio groups with market value / float P&L / day P&L, and host-side read-only agent tools + JSON files exposing every portfolio record for in-session analysis.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "selftest": "node src/host/selftest.ts",
    "install:profile": "bash scripts/install.sh",
    "uninstall:profile": "bash scripts/uninstall.sh"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "web",
    "dsh-better-sidebar",
    "market",
    "portfolio",
    "盯盘",
    "stock"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.24.2",
    "typescript": "^7.0.2"
  }
}
